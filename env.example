# Copy to .env and edit. .env is gitignored — keep tokens out of the repo.

# Public hostname, used for shared links and QR codes
ZECHE_BASE_URL=https://bill.kronask.cc

# Prebuilt image from GitHub Actions. Only used with docker-compose.prod.yml.
ZECHE_IMAGE=ghcr.io/kronask/zeche:latest

# Tesseract languages. Add packages to the Dockerfile before extending this.
ZECHE_OCR_LANG=deu+eng

# Translation: none | libretranslate | ollama | openai
ZECHE_TRANSLATE_PROVIDER=libretranslate
ZECHE_TRANSLATE_TARGET=en
# For ollama instead:
# ZECHE_TRANSLATE_PROVIDER=ollama
# ZECHE_TRANSLATE_URL=http://10.10.10.x:11434
# ZECHE_TRANSLATE_MODEL=qwen2.5:7b

# Languages LibreTranslate loads. Fewer = less RAM and a faster first boot.
LT_LOAD_ONLY=en,de,fr,it,es

# Sharing key of the tricount to prefill (the bit after tricount.com/)
ZECHE_TRICOUNT_KEY=

# Only for the bundled cloudflared service
CLOUDFLARE_TUNNEL_TOKEN=
